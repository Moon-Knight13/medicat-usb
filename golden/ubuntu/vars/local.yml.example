---
# Personal, not-for-the-public-repo values. Copy to vars/local.yml (git-ignored).
# make-stick.sh build copies it onto the stick with the rest of golden/, and the
# first boot applies it from there, so it never needs to be in git.
git_name: Your Name
# GitHub's privacy address is <id>+<login> at users.noreply.github.com (see GitHub > Settings > Emails).
git_email: your-email
# VPNs (OpenConnect/AnyConnect) shown in the panel menu; switch on, authenticate. No passwords stored.
vpns:
  - name: Work            # connection name and tun interface name
    gateway: vpn.example.org
    protocol: anyconnect
    authgroup: GROUP
    username: your-user

# Raspberry Pi (pi-flash, pi). All optional.
pi_default_host: ""        # hostname `pi` uses when you give none, e.g. kitchen-pi
pi_wifi_ssid: ""           # Wi-Fi for new Pis; this laptop must have it saved. Empty: the current Wi-Fi
pi_wifi_country: GB        # Wi-Fi regulatory country
pi_cable_iface: ""         # Ethernet port for `pi local|share` when the laptop has several
pi_authorized_keys: []     # extra public keys, e.g. your other machines: ["ssh-ed25519 AAAA... you@pc"]
