#cloud-config
# deck: disposable media and browsing VM (KVM). Minimal Ubuntu desktop, private Firefox,
# dark mode, no wizard, straight to the desktop. Built by deck-create; its disk is transient.
autoinstall:
  version: 1
  locale: en_GB.UTF-8
  keyboard:
    layout: gb
  timezone: Europe/London
  source:
    id: ubuntu-desktop-minimal
    search_drivers: false
  identity:
    hostname: deck
    username: deck
    realname: Deck
    password: "$6$deck$qLKsh.OpDzWRGB3Hq74.xihlHGIMzn.McAF.GhrjjITVcOR2Bxs76LePQzj8iJnqAC348OZRi1hCZ7o.ZSUo70"
  storage:
    layout:
      name: direct
    swap:
      size: 0
  updates: all
  packages:
    - spice-vdagent        # resize, full screen with virt-viewer
    - qemu-guest-agent
  late-commands:
    # No first-login wizard (also the per-release "upgrade" one), no login screen.
    - curtin in-target -- sh -c '. /etc/os-release; mkdir -p /home/deck/.config/gnome-initial-setup && echo yes > /home/deck/.config/gnome-initial-setup-done && touch /home/deck/.config/gnome-initial-setup/upgrade-$VERSION_ID-done && chown -R deck:deck /home/deck/.config'
    - curtin in-target -- sh -c 'printf "[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=deck\n" > /etc/gdm3/custom.conf'
    # Private Firefox: DuckDuckGo, uBlock Origin, tracking protection, no onboarding.
    - mkdir -p /target/etc/firefox/policies
    - sh -c 'echo  | base64 -d > /target/etc/firefox/policies/policies.json && chmod 755 /target/etc/firefox /target/etc/firefox/policies && chmod 644 /target/etc/firefox/policies/policies.json'
    # Dark mode.
    - mkdir -p /target/etc/dconf/profile /target/etc/dconf/db/local.d
    - sh -c 'echo dXNlci1kYjp1c2VyCnN5c3RlbS1kYjpsb2NhbAo= | base64 -d > /target/etc/dconf/profile/user && echo W29yZy9nbm9tZS9kZXNrdG9wL2ludGVyZmFjZV0KY29sb3Itc2NoZW1lPSdwcmVmZXItZGFyaycKZ3RrLXRoZW1lPSdZYXJ1LWRhcmsnCg== | base64 -d > /target/etc/dconf/db/local.d/00-deck'
    - curtin in-target -- dconf update
  shutdown: poweroff
