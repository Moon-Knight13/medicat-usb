#cloud-config
# deck: minimal Ubuntu desktop (which includes Firefox) with a throwaway account, installed
# unattended by deck-create. VirtualBox puts this on its boot medium as the autoinstall.
autoinstall:
  version: 1
  locale: en_GB.UTF-8
  keyboard:
    layout: gb
  timezone: Europe/London
  source:
    id: ubuntu-desktop-minimal
    search_drivers: false
  identity:
    hostname: deck
    username: deck
    realname: Deck
    password: "$6$deck$qLKsh.OpDzWRGB3Hq74.xihlHGIMzn.McAF.GhrjjITVcOR2Bxs76LePQzj8iJnqAC348OZRi1hCZ7o.ZSUo70"
  storage:
    layout:
      name: direct
    swap:
      size: 0
  updates: security
  packages:
    - virtualbox-guest-utils      # screen auto-resize and full screen (Ubuntu's packaged guest additions)
  late-commands:
    # A disposable browser: no first-login wizard, no login screen, straight to the desktop.
    - curtin in-target -- sh -c 'mkdir -p /home/deck/.config && echo yes > /home/deck/.config/gnome-initial-setup-done && chown -R deck:deck /home/deck/.config'
    - curtin in-target -- sh -c 'printf "[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=deck\n" > /etc/gdm3/custom.conf'
  shutdown: poweroff
