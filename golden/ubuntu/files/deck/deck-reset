#!/bin/bash
# deck-reset — throw away everything done in the "deck" VM since its last snapshot, then start it.
set -euo pipefail
NAME=deck
VBoxManage showvminfo "$NAME" >/dev/null 2>&1 || { echo "no VM called $NAME yet; run deck-create" >&2; exit 1; }
state=$(VBoxManage showvminfo "$NAME" --machinereadable | sed -n 's/^VMState="\(.*\)"$/\1/p')
[[ "$state" == poweroff || "$state" == aborted || "$state" == saved ]] || { VBoxManage controlvm "$NAME" poweroff; sleep 2; }
[[ "$state" == saved ]] && VBoxManage discardstate "$NAME"
VBoxManage snapshot "$NAME" restorecurrent
VBoxManage startvm "$NAME" --type gui >/dev/null
echo "$NAME restored to snapshot \"$(VBoxManage snapshot "$NAME" list --machinereadable | sed -n 's/^CurrentSnapshotName="\(.*\)"$/\1/p')\" and started"
