# Managed by golden/ubuntu/playbook.yml from `vpns:` in vars/local.yml (on the stick, not in git).
# Password is asked for on every connection and never stored.
[connection]
id={{ item.name }}
uuid={{ ('golden-vpn-' ~ item.name) | to_uuid }}
type=vpn
interface-name={{ item.interface | default(item.name) }}
autoconnect=false
permissions=user:{{ golden_user }}:;

[vpn]
service-type=org.freedesktop.NetworkManager.openconnect
gateway={{ item.gateway }}
protocol={{ item.protocol | default('anyconnect') }}
authtype=password
autoconnect-flags=0
certsigs-flags=0
cookie-flags=2
enable_csd_trojan=no
gateway-flags=2
gwcert-flags=2
lasthost-flags=0
pem_passphrase_fsid=no
stoken_source=disabled
xmlconfig-flags=0

[vpn-secrets]
form:main:username={{ item.username }}
{% if item.authgroup is defined %}
form:main:group_list={{ item.authgroup }}
{% endif %}

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto
